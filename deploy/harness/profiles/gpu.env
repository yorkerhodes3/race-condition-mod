# Deployment harness profile: GPU-Server (self-hosted, no cloud)
# Load:  set -a; . deploy/harness/profiles/gpu.env; set +a
# A single box running Docker: your GPU serves the models (vLLM/Ollama), and
# Redis / Postgres+pgvector / Pub/Sub emulator run as containers. No cloud
# account required. See docs/deployment-harnesses.md §4.3 and SYSTEM-DESIGN.md.

DEPLOY_TARGET=gpu

# --- C1 LLM inference: vLLM (OpenAI-compatible) on your GPU ---
# Serve e.g.:  vllm serve <model> --port 8000   (exposes /v1)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
RUNNER_MODEL=openai/gemma-4-E4B-it
OPENAI_API_BASE=http://vllm:8000/v1
OPENAI_API_KEY=not-needed
# Alternative — Ollama instead of vLLM:
# RUNNER_MODEL=ollama_chat/gemma4:e4b
# OLLAMA_API_BASE=http://ollama:11434

# --- C2 Embeddings: local (needs embeddings adapter: backend "local") ---
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_URL=http://vllm:8000/v1        # or a sentence-transformers server
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- C3/C4 Eval + Memory: auto-degrade (heuristic eval, local Postgres memory) ---

# --- C5 Vector store: local Postgres + pgvector container ---
USE_ALLOYDB=false
ALLOYDB_HOST=postgres
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=postgres
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=localdev

# --- C6 Session cache: local Redis container ---
REDIS_ADDR=redis:6379
REDIS_TLS=false

# --- C7 Telemetry bus: Pub/Sub emulator container ---
PUBSUB_EMULATOR_HOST=pubsub:8085
PUBSUB_PROJECT_ID=race-condition
PUBSUB_TOPIC_ID=agent-telemetry

# --- C8 Secrets: file / env injection (no secret manager) ---
SECRETS_BACKEND=env

# --- C9 Maps grounding: off (cached routes) ---
GOOGLE_MAPS_API_KEY=

# --- Scale: lean on the deterministic runner for load without inference cost ---
MAX_RUNNERS_AUTOPILOT=1000
MAX_RUNNERS_LLM=50
