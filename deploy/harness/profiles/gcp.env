# Deployment harness profile: GCP (existing / reference target)
# Load:  set -a; . deploy/harness/profiles/gcp.env; set +a
# Provisioned by infra/ (Terraform → Cloud Run + Agent Engine + Memorystore +
# AlloyDB + Pub/Sub). This profile documents the swappable knobs in GCP form.

DEPLOY_TARGET=gcp

# --- C1 LLM inference: Vertex AI / Gemini ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
RUNNER_MODEL=gemini-3.1-flash-lite-preview
EVALUATOR_MODEL=gemini-3-flash-preview

# --- C2 Embeddings: Vertex AI ---
EMBEDDING_BACKEND=vertex_ai

# --- C5 Vector store / relational: AlloyDB (pgvector) ---
USE_ALLOYDB=true
# ALLOYDB_* resolved from Terraform outputs / AlloyDB Auth Proxy; password via Secret Manager.

# --- C6 Session cache: Memorystore Redis ---
REDIS_ADDR=10.0.0.3:6379
REDIS_TLS=false

# --- C7 Telemetry bus: Pub/Sub (native) ---
# PUBSUB_EMULATOR_HOST intentionally unset → use managed Pub/Sub.
PUBSUB_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_ID=agent-telemetry

# --- C8 Secrets: Secret Manager (via ADC) ---
SECRETS_BACKEND=secret_manager

# --- C9 Maps grounding (optional): Maps MCP + key from Secret Manager ---
# GOOGLE_MAPS_API_KEY resolved at runtime from Secret Manager if unset.
