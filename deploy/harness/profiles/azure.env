# Deployment harness profile: Azure
# Load:  set -a; . deploy/harness/profiles/azure.env; set +a
# Fill in every <PLACEHOLDER>. Never commit real keys — inject secrets via
# Container Apps secrets or Key Vault. See docs/deployment-harnesses.md §4.2.

DEPLOY_TARGET=azure

# --- C1 LLM inference: Azure OpenAI (LiteLLM native "azure/" provider) ---
# RUNNER_MODEL=azure/<your-chat-deployment-name>
GOOGLE_GENAI_USE_VERTEXAI=FALSE
RUNNER_MODEL=azure/gpt-4o-mini
EVALUATOR_MODEL=azure/gpt-4o
AZURE_API_BASE=https://<your-resource>.openai.azure.com
AZURE_API_VERSION=2024-08-01-preview
AZURE_API_KEY=<inject-via-secret>            # DO NOT COMMIT
# Alternative: host models on AKS with vLLM and use the GPU profile's OPENAI_* vars.

# --- C2 Embeddings: Azure OpenAI (needs embeddings adapter: backend "azure") ---
EMBEDDING_BACKEND=azure
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- C3/C4 Eval + Memory: auto-degrade off Vertex (heuristic eval, DB-backed memory) ---
# No Vertex Eval/Memory Bank on Azure; the code falls back automatically.

# --- C5 Vector store: Azure Database for PostgreSQL Flexible Server + pgvector ---
# Run once on the DB:  CREATE EXTENSION IF NOT EXISTS vector;
USE_ALLOYDB=false
DATABASE_URL=postgresql://<user>:<pw>@<server>.postgres.database.azure.com:5432/postgres?sslmode=require
ALLOYDB_HOST=<server>.postgres.database.azure.com
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=postgres
ALLOYDB_USER=<user>
ALLOYDB_PASSWORD=<inject-via-secret>         # DO NOT COMMIT

# --- C6 Session cache: Azure Cache for Redis (TLS on 6380) ---
REDIS_ADDR=<name>.redis.cache.windows.net:6380
REDIS_TLS=true
REDIS_PASSWORD=<inject-via-secret>           # DO NOT COMMIT

# --- C7 Telemetry bus: Pub/Sub emulator container (portable, recommended) ---
# Run the cloud-sdk pubsub emulator as a sidecar container on ACA/AKS.
PUBSUB_EMULATOR_HOST=pubsub:8085
PUBSUB_PROJECT_ID=race-condition
PUBSUB_TOPIC_ID=agent-telemetry

# --- C8 Secrets: Key Vault (adapter) or Container Apps secrets injected as env ---
SECRETS_BACKEND=env

# --- C9 Maps grounding: off by default (use cached routes). Optional Azure Maps adapter. ---
GOOGLE_MAPS_API_KEY=
